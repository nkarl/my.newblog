{
    "name": "halogen-new-blog",
    "version": "0.0.1.0",
    "scripts": {
        "content": "node scripts/build-content.mjs",
        "clean": "rm -rf output .spago dist/*.js .cache",
        "build": "pnpm content && spago build",
        "test": "pnpm content && spago test",
        "serve": "pnpm build && esbuild --bundle index.js --outfile=dist/index.js --servedir=dist",
        "bundle": "pnpm build && esbuild --bundle index.js --minify --outfile=dist/index.js"
    },
    "author": "Charles Lambert Nguyen",
    "license": "ISC",
    "description": "A PureScript and Halogen blog.",
    "packageManager": "pnpm@11.24.0",
    "dependencies": {
        "@wcj/markdown-to-html": "^3.0.4",
        "esbuild": "^0.25.1",
        "sanitize-html": "^2.17.7"
    },
    "devDependencies": {
        "purescript": "^0.15.16",
        "spago": "^1.0.4"
    }
}
